# ---------------------------------------------------------------------------
# Browser-safe values (Vite exposes anything prefixed VITE_ to the client).
# The Firebase web config currently lives in src/lib/firebase.js.
# Supabase anon keys are public by design; never put a service-role key or a
# provider secret in a VITE_ variable.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# ---------------------------------------------------------------------------
# Server-only values. Set these as Firebase Functions secrets
# (`firebase functions:secrets:set NAME`) or in an untracked
# functions/.env.<project-id> file for the emulator. Never commit them.
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# INNGEST_EVENT_KEY=YOUR_INNGEST_EVENT_KEY
# INNGEST_SIGNING_KEY=YOUR_INNGEST_SIGNING_KEY
# OPENAI_API_KEY=YOUR_OPENAI_KEY
# GEMINI_API_KEY=YOUR_GEMINI_KEY
# YOUTUBE_API_KEY=YOUR_YOUTUBE_DATA_API_KEY
# SEMANTIC_SCHOLAR_API_KEY=OPTIONAL
# LANGFUSE_PUBLIC_KEY=YOUR_LANGFUSE_PUBLIC_KEY
# LANGFUSE_SECRET_KEY=YOUR_LANGFUSE_SECRET_KEY
# SENTRY_DSN=YOUR_SENTRY_DSN

# Non-secret Functions parameters (prompted on first deploy; defaults shown).
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# DAILY_COURSE_RUN_LIMIT=3
# PROJECT_DAILY_SPEND_LIMIT_USD=25
# OPENAI_EMBEDDING_COST_PER_MILLION_USD=0.02
# ALLOW_NONCOMMERCIAL_SOURCES=false
# ADMIN_FIREBASE_UIDS=comma,separated,uids   # may read the feedback queue and analytics
# OPENAI_MODEL=gpt-6.1-sol
# GEMINI_MODEL=gemini-3.8-flash
# OPENAI_INPUT_USD_PER_MILLION=10
# OPENAI_OUTPUT_USD_PER_MILLION=40
# GEMINI_INPUT_USD_PER_MILLION=2
# GEMINI_OUTPUT_USD_PER_MILLION=10

# The legacy Groq integration was removed; VITE_GROQ_* keys are no longer read.
