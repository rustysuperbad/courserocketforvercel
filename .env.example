# Browser-safe Firebase app settings (the existing app currently reads them from src/lib/firebase.js).
# Supabase anon keys are public by design; never put a service role key or provider secret in VITE_ variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-only values. Configure these in Firebase Functions secrets or the local functions/.env file.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# INNGEST_EVENT_KEY=YOUR_INNGEST_EVENT_KEY
# INNGEST_SIGNING_KEY=YOUR_INNGEST_SIGNING_KEY
# OPENAI_API_KEY=YOUR_OPENAI_KEY
# LANGFUSE_PUBLIC_KEY=YOUR_LANGFUSE_PUBLIC_KEY
# LANGFUSE_SECRET_KEY=YOUR_LANGFUSE_SECRET_KEY
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# SENTRY_DSN=YOUR_SENTRY_DSN
# PROJECT_DAILY_SPEND_LIMIT_USD=25
# DAILY_COURSE_RUN_LIMIT=3
