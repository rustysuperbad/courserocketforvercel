{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "CourseRocket",
        "supportEmail": "courserocketstartup@gmail.com",
        "authorizedRedirectUris": [
          "http://localhost",
          "https://courserocket26.firebaseapp.com",
          "https://courserocket26.vercel.app"
        ]
      }
    }
  }
}
